{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "orange", "value": 2 },
              { "color": "red", "value": 3 }
            ]
          },
          "mappings": [
            {
              "options": {
                "0": { "text": "CAVOK" },
                "1": { "text": "VMC" },
                "2": { "text": "IMC" },
                "3": { "text": "LIFR" }
              },
              "type": "value"
            }
          ]
        }
      },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none"
      },
      "title": "Weather Category",
      "type": "stat",
      "targets": [
        { "expr": "weather_category", "legendFormat": "", "refId": "A" }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 1500 },
              { "color": "green", "value": 5000 }
            ]
          },
          "unit": "m",
          "min": 0,
          "max": 10000
        }
      },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "title": "Visibility",
      "type": "gauge",
      "targets": [{ "expr": "visibility_m", "legendFormat": "", "refId": "A" }]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 15 },
              { "color": "red", "value": 30 }
            ]
          },
          "unit": "kt",
          "min": 0,
          "max": 50
        }
      },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "title": "Wind Speed",
      "type": "gauge",
      "targets": [
        { "expr": "wind_speed_kt", "legendFormat": "Sustained", "refId": "A" },
        { "expr": "wind_gust_kt", "legendFormat": "Gust", "refId": "B" }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 30,
            "showPoints": "never"
          },
          "mappings": [
            {
              "options": {
                "0": { "text": "CAVOK" },
                "1": { "text": "VMC" },
                "2": { "text": "IMC" },
                "3": { "text": "LIFR" }
              },
              "type": "value"
            }
          ]
        }
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 5 },
      "id": 4,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "title": "Weather Category (history)",
      "type": "timeseries",
      "targets": [
        { "expr": "weather_category", "legendFormat": "Category", "refId": "A" }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never"
          }
        }
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 5 },
      "id": 5,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "title": "Flights Delayed by Weather",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(flights_delayed_by_weather_total[5m])",
          "legendFormat": "{{ category }}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "filterable": true }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "severity" },
            "properties": [
              { "id": "custom.displayMode", "value": "color-text" },
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "critical": { "color": "red" },
                      "high": { "color": "orange" },
                      "medium": { "color": "yellow" },
                      "low": { "color": "green" }
                    },
                    "type": "value"
                  }
                ]
              }
            ]
          }
        ]
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 12 },
      "id": 6,
      "options": {
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Value" }]
      },
      "title": "Active Incidents",
      "type": "table",
      "targets": [
        {
          "expr": "incidents_active",
          "legendFormat": "{{ type }} / {{ severity }}",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "stacking": { "mode": "normal" },
            "showPoints": "never"
          }
        }
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 12 },
      "id": 7,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "title": "Incidents Created (rate)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(incidents_created_total[5m])",
          "legendFormat": "{{ type }}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "scheme", "schemeName": "Oranges" },
          "custom": { "fillOpacity": 80 }
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 19 },
      "id": 8,
      "options": {
        "calculate": false,
        "cellGap": 2,
        "yAxis": { "axisPlacement": "left" }
      },
      "title": "Time-to-Resolve",
      "type": "heatmap",
      "targets": [
        {
          "expr": "rate(incident_ttr_minutes_bucket[10m])",
          "legendFormat": "{{ le }}",
          "refId": "A",
          "format": "heatmap"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 3 },
              { "color": "red", "value": 4 }
            ]
          }
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 19 },
      "id": 9,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      },
      "title": "Cascade Depth Max",
      "type": "stat",
      "targets": [
        {
          "expr": "cascade_depth_max or vector(0)",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 19 },
      "id": 10,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "title": "Protocols Activated",
      "type": "bargauge",
      "targets": [
        {
          "expr": "protocols_activated_total",
          "legendFormat": "{{ protocol }}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["arthur-airport", "weather", "incidents"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "Weather & Incidents",
  "uid": "art-weather-incidents"
}
