    "FlightStatusChanged",
    "FlightGateAssigned",
    "FlightCancelled",
    "FlightDiverted",
    "FlightCTOTAssigned",
    "WeatherStateChanged",
    "IncidentCreated",
    "IncidentStatusChanged",
