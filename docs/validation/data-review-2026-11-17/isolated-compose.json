{
  "name": "art-data-review",
  "services": {
    "neo4j": {
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "image": "neo4j:5",
      "restart": "unless-stopped",
      "networks": [
        "art-net"
      ],
      "ports": [
        "127.0.0.1:17687:7687",
        "127.0.0.1:17474:7474"
      ],
      "environment": {
        "NEO4J_AUTH": "neo4j/art-digital-twin",
        "NEO4J_PLUGINS": "[]",
        "NEO4J_server_memory_heap_initial__size": "1G",
        "NEO4J_server_memory_heap_max__size": "2G",
        "NEO4J_server_memory_pagecache_size": "2G",
        "NEO4J_db_tx__log_rotation_retention__policy": "256M size",
        "NEO4J_db_tx__log_rotation_size": "16M",
        "NEO4J_dbms_cypher_statistics__divergence__threshold": "0.9",
        "NEO4J_dbms_cypher_min__replan__interval": "60s",
        "OTEL_ENABLED": "false"
      },
      "volumes": [
        "neo4j-data:/data",
        "neo4j-logs:/logs"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "wget",
          "-qO-",
          "http://localhost:7474"
        ],
        "interval": "10s",
        "timeout": "5s",
        "retries": 10
      }
    },
    "zookeeper": {
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "image": "confluentinc/cp-zookeeper:7.6.0",
      "restart": "unless-stopped",
      "networks": [
        "art-net"
      ],
      "environment": {
        "ZOOKEEPER_CLIENT_PORT": 2181,
        "ZOOKEEPER_TICK_TIME": 2000,
        "ZOOKEEPER_AUTOPURGE_SNAP_RETAIN_COUNT": 3,
        "ZOOKEEPER_AUTOPURGE_PURGE_INTERVAL": 1,
        "OTEL_ENABLED": "false"
      },
      "volumes": [
        "zookeeper-data:/var/lib/zookeeper/data",
        "zookeeper-logs:/var/lib/zookeeper/log"
      ],
      "ports": []
    },
    "kafka": {
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "image": "confluentinc/cp-kafka:7.6.0",
      "restart": "unless-stopped",
      "networks": [
        "art-net"
      ],
      "ports": [],
      "depends_on": [
        "zookeeper"
      ],
      "environment": {
        "KAFKA_BROKER_ID": 1,
        "KAFKA_ZOOKEEPER_CONNECT": "zookeeper:2181",
        "KAFKA_ADVERTISED_LISTENERS": "PLAINTEXT://kafka:9092",
        "KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR": 1,
        "KAFKA_AUTO_CREATE_TOPICS_ENABLE": "false",
        "KAFKA_LOG_RETENTION_HOURS": 168,
        "KAFKA_LOG_RETENTION_BYTES": 67108864,
        "KAFKA_LOG_SEGMENT_BYTES": 16777216,
        "KAFKA_LOG_ROLL_MS": 3600000,
        "KAFKA_LOG_RETENTION_CHECK_INTERVAL_MS": 60000,
        "OTEL_ENABLED": "false"
      },
      "volumes": [
        "kafka-data:/var/lib/kafka/data"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "kafka-broker-api-versions",
          "--bootstrap-server",
          "localhost:9092"
        ],
        "interval": "10s",
        "timeout": "10s",
        "retries": 10
      }
    },
    "kafka-init": {
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "image": "confluentinc/cp-kafka:7.6.0",
      "networks": [
        "art-net"
      ],
      "depends_on": {
        "kafka": {
          "condition": "service_healthy"
        }
      },
      "restart": "no",
      "entrypoint": [
        "/bin/bash",
        "-c"
      ],
      "command": [
        "echo \"Creating Kafka topics...\"\ntopics=(\n  \"sim.clock:1:1\"\n  \"flights.events:6:1\"\n  \"flights.schedule:1:1\"\n  \"passengers.events:6:1\"\n  \"baggage.events:6:1\"\n  \"weather.events:1:1\"\n  \"incidents.events:3:1\"\n  \"incidents.alerts:3:1\"\n  \"incidents.inject:1:1\"\n  \"ground.events:3:1\"\n  \"analysis.events:3:1\"\n  \"planning.events:1:1\"\n  \"flights.commands:6:1\"\n  \"passengers.commands:3:1\"\n  \"baggage.commands:3:1\"\n  \"incidents.commands:3:1\"\n  \"cost.events:3:1\"\n  \"sim.watermark:1:1\"\n)\nfor entry in \"$${topics[@]}\"; do\n  IFS=':' read -r topic partitions replication <<< \"$$entry\"\n  kafka-topics --bootstrap-server kafka:9092 \\\n    --create --if-not-exists \\\n    --topic \"$$topic\" \\\n    --partitions \"$$partitions\" \\\n    --replication-factor \"$$replication\" \\\n    && echo \"  \u2713 $$topic ($$partitions partitions)\" \\\n    || exit 1\ndone\necho \"All topics created.\"\n"
      ],
      "volumes": [],
      "ports": []
    },
